# --- Build Artifacts (Rust/Solana) ---
# Compiled binaries, object files, and temporary outputs generated by the Rust compiler (Cargo).
target/

# Compilation and configuration artifacts generated by the Anchor framework.
.anchor/

# Local test ledger data used for Solana development environments.
test-ledger/

# --- Operating System & Editor Files ---
# macOS system files for folder view preferences.
.DS_Store

# Backup files generated by certain text editors.
**/*.rs.bk

# --- Package Manager Dependencies (Node.js) ---
# Dependencies installed by npm/yarn (node packages).
node_modules/

# Yarn package manager cache and configuration files (especially for PnP mode).
.yarn/
